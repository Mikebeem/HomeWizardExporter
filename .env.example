# HomeWizard P1 Meter Configuration
# Change this to the IP address of your HomeWizard P1 meter
HOMEWIZARD_HOST=192.168.1.100

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=homewizard
DB_USER=postgres
# IMPORTANT: Change this to a strong password for production!
DB_PASSWORD=changeme

# Poll interval in seconds (how often to read from the meter)
POLL_INTERVAL=30
