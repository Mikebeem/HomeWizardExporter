# HomeWizard P1 Meter Configuration
# REQUIRED: Change this to the IP address of your HomeWizard P1 meter
HOMEWIZARD_HOST=192.168.1.100

# Database Configuration
# REQUIRED: Set a strong password for production!
POSTGRES_DB=homewizard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Poll interval in seconds (how often to read from the meter)
POLL_INTERVAL=30
